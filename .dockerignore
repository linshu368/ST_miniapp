# Build context shrink for ops/docker/Dockerfile.st-bundle.
# NOTE: do NOT exclude packages/shared or packages/bridge-protocol —
# st-extension and sync-engine depend on them. Do NOT exclude vendor/ (ST itself).

node_modules
**/node_modules
**/.next
**/dist
**/.turbo
.git
.github
.vscode
.idea
*.log
.env
.env.*
!.env.example

# st-bundle does not need frontend/backend sources
packages/frontend
packages/backend
packages/db-types/generated

docs
ops/nginx
ops/env

# The simulation gateway is built from the repository root.
!ops/nginx/
ops/nginx/*
!ops/nginx/Dockerfile.simulation
!ops/nginx/nginx.simulation.conf
