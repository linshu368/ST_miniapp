# =============================================================================
# ST_miniAPP — docker-compose environment template (M4).
#
#   cp .env.compose.example .env.compose   then fill in REAL values.
#
# docker-compose.yml loads this file (as .env.compose) into st-backend, backend
# and frontend. .env.compose is git-ignored — NEVER commit real secrets.
# Every value below is a placeholder (changeme / placeholder); the stack boots
# and passes health/smoke checks with these, but DB-backed features stay inert
# until real Supabase/DB credentials are supplied.
#
# Vars are grouped by the service that consumes them. Shared vars (e.g.
# ST_USER_PASSWORD_SECRET, SUPABASE_*) MUST hold the same value across services.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Shared
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# backend — packages/backend/src/platform/config.ts
# ─────────────────────────────────────────────────────────────────────────────
# Listen port (source: process.env.PORT || 3001). Matches nginx upstream backend:3001.
PORT=3001
# CORS allow-origin + bridge target. Behind the gateway this is the public origin.
FRONTEND_URL=http://localhost:8080
TELEGRAM_BOT_TOKEN=changeme-telegram-bot-token

# Database (Prisma). DATABASE_URL must be NON-EMPTY or PrismaClient init throws at
# boot (lib/db.ts). The placeholder lets the process start; queries fail lazily.
DATABASE_URL=postgresql://placeholder:placeholder@db.placeholder.local:5432/postgres?schema=miniapp
DIRECT_URL=postgresql://placeholder:placeholder@db.placeholder.local:5432/postgres?schema=miniapp

# Supabase (service_role). URL must be a valid URL; key length >= 10
# (sync-engine config zod guard). Used by backend Bridge + sync-engine.
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-changeme
SUPABASE_PROJECT_REF=placeholderref

# ST reverse-proxy targets used by backend (internal DNS on app-net).
ST_BASE_URL=http://st-backend:8000
ST_PROVISION_URL=http://st-backend:9091
# HMAC secret deriving each ST user's password. MUST match sync-engine (>= 16 chars).
ST_USER_PASSWORD_SECRET=changeme-please-use-a-32char-min-secret

# Payment (JLPay). Disabled by default; placeholders keep the module dormant.
PAYMENT_ENABLED=false
PAYMENT_MERCHANT_ID=changeme-merchant-id
PAYMENT_MERCHANT_KEY=changeme-merchant-key
PAYMENT_BASE_URL=http://jlusdt.com
PAYMENT_NOTIFY_URL=http://localhost:8080/api/payment/webhook/jlpay
PAYMENT_RETURN_URL=http://localhost:8080/api/payment/return

# ─────────────────────────────────────────────────────────────────────────────
# st-backend — packages/sync-engine (provision-api + watcher), M1 env contract
#   (packages/sync-engine/.env.example + src/lib/config.ts zod schema)
# ─────────────────────────────────────────────────────────────────────────────
# development | test | production (selects TEST_*/PROD_* Supabase groups).
DATABASE_ENV=test
# ST data dir INSIDE the st-bundle container (== image VOLUME == st-mongo-data mount).
ST_DATA_PATH=/home/node/app/data
# ST admin account (sync-engine uses it for POST /api/users/create).
ST_ADMIN_USERNAME=admin
ST_ADMIN_PASSWORD=changeme-st-admin-password
# Supabase Storage bucket for character-card PNGs.
CHARACTER_STORAGE_BUCKET=character-assets
# ST's LLM endpoint -> platform proxy. Must be reachable from the ST process.
LLM_PROXY_URL=http://backend:3001/api/platform/llm-proxy/v1
# Internal service ports (defaults; do not publish to host).
PROVISION_API_PORT=9091
HEALTH_PORT=9090
# NOTE: PROVISION_API_BIND_HOST is set to 0.0.0.0 in docker-compose.yml (not here)
# so nginx can reach provision-api across containers.
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# frontend — packages/frontend (NEXT_PUBLIC_*)
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: NEXT_PUBLIC_* are inlined into the client bundle at BUILD time, not
# read at runtime. To change them, pass NEXT_PUBLIC_API_URL as a compose build arg
# (see docker-compose.yml) and rebuild. Listed here for documentation only.
# Empty => same-origin (relative) API calls through the nginx gateway.
NEXT_PUBLIC_API_URL=
# Optional local/dev toggles (leave unset/0 for real backend calls):
NEXT_PUBLIC_USE_MOCK=0
NEXT_PUBLIC_USE_MOCK_INIT_DATA=0
NEXT_PUBLIC_MOCK_USER_ID=123456789
