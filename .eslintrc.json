{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["import"],
  "overrides": [
    {
      "files": ["packages/frontend/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@miniapp/backend",
                  "@miniapp/backend/*",
                  "@miniapp/admin",
                  "@miniapp/admin/*",
                  "@miniapp/cs-platform",
                  "@miniapp/cs-platform/*"
                ],
                "message": "应用包互不 import，跨进程走 HTTP（架构铁律 §3）"
              },
              {
                "group": [
                  "**/backend/**",
                  "**/admin/**",
                  "**/cs-platform/**",
                  "**/packages/backend/**",
                  "**/packages/admin/**",
                  "**/packages/cs-platform/**"
                ],
                "message": "禁止相对路径跨应用包（架构铁律 §3）"
              },
              {
                "group": ["@miniapp/db-types", "@miniapp/db-types/*"],
                "message": "db-types 已删除，前端只消费 @miniapp/shared"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/backend/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@miniapp/frontend",
                  "@miniapp/frontend/*",
                  "@miniapp/admin",
                  "@miniapp/admin/*",
                  "@miniapp/cs-platform",
                  "@miniapp/cs-platform/*"
                ],
                "message": "应用包互不 import，跨进程走 HTTP（架构铁律 §3）"
              },
              {
                "group": [
                  "**/frontend/**",
                  "**/admin/**",
                  "**/cs-platform/**",
                  "**/packages/frontend/**",
                  "**/packages/admin/**",
                  "**/packages/cs-platform/**"
                ],
                "message": "禁止相对路径跨应用包（架构铁律 §3）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/admin/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@miniapp/frontend",
                  "@miniapp/frontend/*",
                  "@miniapp/backend",
                  "@miniapp/backend/*",
                  "@miniapp/cs-platform",
                  "@miniapp/cs-platform/*"
                ],
                "message": "应用包互不 import，跨进程走 HTTP（架构铁律 §3）"
              },
              {
                "group": [
                  "**/frontend/**",
                  "**/backend/**",
                  "**/cs-platform/**",
                  "**/packages/frontend/**",
                  "**/packages/backend/**",
                  "**/packages/cs-platform/**"
                ],
                "message": "禁止相对路径跨应用包（架构铁律 §3）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/cs-platform/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@miniapp/frontend",
                  "@miniapp/frontend/*",
                  "@miniapp/backend",
                  "@miniapp/backend/*",
                  "@miniapp/admin",
                  "@miniapp/admin/*"
                ],
                "message": "应用包互不 import，跨进程走 HTTP（架构铁律 §3）"
              },
              {
                "group": [
                  "**/frontend/**",
                  "**/backend/**",
                  "**/admin/**",
                  "**/packages/frontend/**",
                  "**/packages/backend/**",
                  "**/packages/admin/**"
                ],
                "message": "禁止相对路径跨应用包（架构铁律 §3）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/shared/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@miniapp/frontend",
                  "@miniapp/frontend/*",
                  "@miniapp/backend",
                  "@miniapp/backend/*",
                  "@miniapp/admin",
                  "@miniapp/admin/*",
                  "@miniapp/cs-platform",
                  "@miniapp/cs-platform/*"
                ],
                "message": "契约层包禁止 import 应用层包（架构铁律 §4.4）"
              },
              {
                "group": [
                  "**/frontend/**",
                  "**/backend/**",
                  "**/admin/**",
                  "**/cs-platform/**",
                  "**/packages/frontend/**",
                  "**/packages/backend/**",
                  "**/packages/admin/**",
                  "**/packages/cs-platform/**"
                ],
                "message": "契约层禁止相对路径引用应用包（架构铁律 §4.4）"
              }
            ]
          }
        ]
      }
    }
  ]
}
