    "mobile_performance": {
      "schema_version": 1,
      "mode": "required",
      "pages": [],
      "apis": [
        "POST /api/v1/conversations/:id/messages",
        "GET /api/conversations/:sessionId/status",
        "POST /api/conversations/:sessionId/status/refresh",
