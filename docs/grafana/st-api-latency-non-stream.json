{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "content": "# 非流式 API 耗时\n浏览器 `api.total` 是统一客户端从调用到最终解析/失败的总等待，含排队、有限 GET 重试和 body 解析；按有限 `api_route`、method、Android/iOS 看。服务端 `st_http_server_duration_seconds` 是 Fastify onResponse 生命周期，按真实 route/method/status 看，没有客户端平台标签。两种独立时钟不得相加、相减或逐请求配对。服务端查询显式排除 send/regenerate SSE、creator polish NDJSON 与 `/api/telemetry/*`；客户端流式 owner 本来不进入 `api.total`。响应阶段目标 ≤2s，失败与 N 同看。",
        "mode": "markdown"
      },
      "title": "两个独立口径与流式排除规则",
      "type": "text"
    },
    {
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 2000 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, ${browser_selector:raw} |= \"st_api_total\" | logfmt | kind=\"measurement\" | type=\"st_api_total\" | app_name=\"st-miniapp\" | app_environment=\"$environment\" | app_version=~\"$release\" | context_measurement_version=\"engineering_v1\" | context_source_measurement_version=\"api_logical_v1\" | context_outcome=\"ok\" | context_api_route=~\"$api_route\" | context_method=~\"$method\" | context_tg_platform=~\"$tg_platform\" | unwrap duration_ms | __error__=\"\" [$__range]) by (context_api_route, context_method, context_tg_platform)",
          "legendFormat": "{{context_api_route}} {{context_method}} {{context_tg_platform}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "客户端总等待 P95（目标 ≤2000ms）",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "description": "同一批成功 api.total 的 duration_ms≤2000；失败另列。",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.95 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
          "editorMode": "code",
          "expr": "sum by (context_api_route, context_method, context_tg_platform) (count_over_time(${browser_selector:raw} |= \"st_api_total\" | logfmt | kind=\"measurement\" | type=\"st_api_total\" | app_environment=\"$environment\" | app_version=~\"$release\" | context_measurement_version=\"engineering_v1\" | context_source_measurement_version=\"api_logical_v1\" | context_outcome=\"ok\" | context_api_route=~\"$api_route\" | context_method=~\"$method\" | context_tg_platform=~\"$tg_platform\" | duration_ms <= 2000 [$__range])) / sum by (context_api_route, context_method, context_tg_platform) (count_over_time(${browser_selector:raw} |= \"st_api_total\" | logfmt | kind=\"measurement\" | type=\"st_api_total\" | app_environment=\"$environment\" | app_version=~\"$release\" | context_measurement_version=\"engineering_v1\" | context_source_measurement_version=\"api_logical_v1\" | context_outcome=\"ok\" | context_api_route=~\"$api_route\" | context_method=~\"$method\" | context_tg_platform=~\"$tg_platform\" [$__range]))",
          "legendFormat": "{{context_api_route}} {{context_method}} {{context_tg_platform}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "客户端 2秒内完成占比",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "description": "成功 N；单 route/method/platform N<100 延长窗口。",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 100 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
          "editorMode": "code",
          "expr": "sum by (context_api_route, context_method, context_tg_platform) (count_over_time(${browser_selector:raw} |= \"st_api_total\" | logfmt | kind=\"measurement\" | type=\"st_api_total\" | app_environment=\"$environment\" | app_version=~\"$release\" | context_measurement_version=\"engineering_v1\" | context_source_measurement_version=\"api_logical_v1\" | context_outcome=\"ok\" | context_api_route=~\"$api_route\" | context_method=~\"$method\" | context_tg_platform=~\"$tg_platform\" [$__range]))",
          "legendFormat": "{{context_api_route}} {{context_method}} {{context_tg_platform}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "客户端成功样本量 N",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "description": "ok/http_error/network_error/aborted/timeout 等最终结果，不从成功 P95 推断失败。",
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 13 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
          "editorMode": "code",
          "expr": "sum by (event_data_api_route, event_data_method, event_data_tg_platform, event_data_outcome, event_data_status_class) (count_over_time(${browser_selector:raw} |= \"st_api_terminal\" | logfmt | kind=\"event\" | event_name=\"st_api_terminal\" | app_environment=\"$environment\" | app_version=~\"$release\" | event_data_measurement_version=\"engineering_v1\" | event_data_source_measurement_version=\"api_logical_v1\" | event_data_api_route=~\"$api_route\" | event_data_method=~\"$method\" | event_data_tg_platform=~\"$tg_platform\" [$__auto]))",
          "legendFormat": "{{event_data_api_route}} {{event_data_method}} {{event_data_tg_platform}} {{event_data_outcome}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "客户端最终结果分母",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "description": "服务端完整 onResponse 生命周期；没有 tg_platform 标签。SSE/NDJSON/telemetry route 已显式排除。阈值 2 秒等价于 2000ms。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 2 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 21 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, route, method) (rate(st_http_server_duration_seconds_bucket{environment=\"$environment\",release=~\"$release\",route=~\"$server_route\",route!~\"^/api/v1/conversations/:id/(messages|regenerate)$\",route!=\"/api/creator/polish\",route!~\"^/api/telemetry/.*\"}[$__rate_interval])))",
          "legendFormat": "{{route}} {{method}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "服务端非流式 route P95（2秒阈值）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "description": "服务端请求量与 status_class；与左侧客户端 N 不是同一分母。",
      "fieldConfig": { "defaults": { "noValue": "No data", "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 21 },
      "id": 7,
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
          "editorMode": "code",
          "expr": "sum by (route, method, status_class) (increase(st_http_server_requests_total{environment=\"$environment\",release=~\"$release\",route=~\"$server_route\",route!~\"^/api/v1/conversations/:id/(messages|regenerate)$\",route!=\"/api/creator/polish\",route!~\"^/api/telemetry/.*\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{route}} {{method}} {{status_class}}",
          "refId": "A"
        }
      ],
      "title": "服务端非流式请求量与失败分母",
      "type": "table"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["st-miniapp", "engineering", "api", "latency"],
