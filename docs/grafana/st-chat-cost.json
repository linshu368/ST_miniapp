    {
      "id": 10,
      "type": "table",
      "title": "按模型：每次调用成本与成本结构",
      "description": "成本结构 = 各部分占这个模型总成本的比例；首发交付 + 首发落败/取消 + 首字兜底 + 出字后重写 = 100%",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fg1oltvmm56v4b"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fg1oltvmm56v4b"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE lane WHEN 'chat' THEN '付费' ELSE '畅聊' END AS \"平台\", model_id AS \"模型\", count(*) AS \"调用次数\",\n  sum(total_cost_usd) AS \"总成本\",\n  1000 * avg(total_cost_usd) AS \"每千次成本\",\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY total_cost_usd) AS \"单次 p50\",\n  percentile_cont(0.9) WITHIN GROUP (ORDER BY total_cost_usd) AS \"单次 p90\",\n  avg(calls) AS \"每次几路模型调用\",\n  sum(primary_won_cost_usd) / NULLIF(sum(total_cost_usd), 0) AS \"首发交付\",\n  sum(primary_lost_cost_usd) / NULLIF(sum(total_cost_usd), 0) AS \"首发落败/取消\",\n  sum(fallback_cost_usd) / NULLIF(sum(total_cost_usd), 0) AS \"首字兜底\",\n  sum(rewrite_cost_usd) / NULLIF(sum(total_cost_usd), 0) AS \"出字后重写\",\n  sum(pending_calls + unavailable_calls) AS \"成本未知的模型调用\"\nFROM analytics.chat_turn_costs WHERE $__timeFilter(turn_at) AND turn_at < now() - interval '30 minutes' AND lane IN (${lane:sqlstring}) AND model_id IN (${model:sqlstring})\nGROUP BY lane, model_id ORDER BY sum(total_cost_usd) DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
