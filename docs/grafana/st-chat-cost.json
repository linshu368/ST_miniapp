    {
      "id": 3,
      "type": "stat",
      "title": "每千次调用成本（美元）",
      "description": "总成本 ÷ 调用次数 × 1000：一次调用平均花多少钱（含兜底、并发、重写）",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fg1oltvmm56v4b"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fg1oltvmm56v4b"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 1000 * sum(total_cost_usd) FILTER (WHERE lane = 'chat') / NULLIF(count(*) FILTER (WHERE lane = 'chat'), 0) AS \"付费\", 1000 * sum(total_cost_usd) FILTER (WHERE lane = 'free_zone') / NULLIF(count(*) FILTER (WHERE lane = 'free_zone'), 0) AS \"畅聊\" FROM analytics.chat_turn_costs WHERE $__timeFilter(turn_at) AND turn_at < now() - interval '30 minutes' AND lane IN (${lane:sqlstring}) AND model_id IN (${model:sqlstring})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
