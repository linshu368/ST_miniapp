          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(sum(total_cost_usd) FILTER (WHERE lane = 'chat'), 0) AS \"付费\", COALESCE(sum(total_cost_usd) FILTER (WHERE lane = 'free_zone'), 0) AS \"畅聊\" FROM analytics.chat_turn_costs WHERE $__timeFilter(turn_at) AND turn_at < now() - interval '30 minutes' AND lane IN (${lane:sqlstring}) AND model_id IN (${model:sqlstring})",
