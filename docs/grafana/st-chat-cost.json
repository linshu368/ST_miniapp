      "title": "成本已知的模型调用占比",
      "description": "其余是待补（还没查到账单）或补不到（被取消、超时，没拿到账单，按 0 计）。404 派不出单本来不收费，也算在补不到里",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fg1oltvmm56v4b"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fg1oltvmm56v4b"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(known_calls) FILTER (WHERE lane = 'chat')::numeric / NULLIF(sum(calls) FILTER (WHERE lane = 'chat'), 0) AS \"付费\", sum(known_calls) FILTER (WHERE lane = 'free_zone')::numeric / NULLIF(sum(calls) FILTER (WHERE lane = 'free_zone'), 0) AS \"畅聊\" FROM analytics.chat_turn_costs WHERE $__timeFilter(turn_at) AND turn_at < now() - interval '30 minutes' AND lane IN (${lane:sqlstring}) AND model_id IN (${model:sqlstring})",
          "refId": "A"
        }
      ],
