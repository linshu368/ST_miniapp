      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fg1oltvmm56v4b"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE lane = 'chat') AS \"付费\", count(*) FILTER (WHERE lane = 'free_zone') AS \"畅聊\" FROM analytics.chat_turn_costs WHERE $__timeFilter(turn_at) AND turn_at < now() - interval '30 minutes' AND lane IN (${lane:sqlstring}) AND model_id IN (${model:sqlstring})",
          "refId": "A"
