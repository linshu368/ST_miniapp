    {
      "id": 1,
      "type": "stat",
      "title": "调用次数",
      "description": "用户发一次消息或重新生成算一次（一条回复）",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fg1oltvmm56v4b"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
