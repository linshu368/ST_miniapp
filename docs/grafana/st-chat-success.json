{
  "uid": "st-chat-success",
  "title": "聊天｜成功率与首发失败",
  "description": "用户视角成功率与首发平台+模型失败率（报错/中断/拒答/超时）。数据：st_chat_turns_total。",
  "tags": ["ST", "chat", "fallback", "production"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "lane",
        "label": "栏目",
        "type": "custom",
        "query": "全部 : chat|free_zone, 付费聊天 : chat, 畅聊 : free_zone",
        "current": {
          "text": "全部",
          "value": "chat|free_zone"
        },
        "options": [],
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "fail_type",
        "label": "失败类型",
        "type": "custom",
        "query": "全部 : error|interrupted|refused|timeout, 报错 : error, 中断 : interrupted, 拒答 : refused, 超时 : timeout",
        "current": {
          "text": "全部",
          "value": "error|interrupted|refused|timeout"
        },
        "options": [],
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "大盘",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "用户成功率",
      "description": "用户视角：首发 + 首字兜底 + 出字后重写共同作用之后，用户最终没拿到正常回答的比例。 不计余额/VIP 拒绝和用户停止。",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "sum(increase(st_chat_turns_total{deployment_environment_name=\"production\", lane=~\"$lane\", outcome=\"success\"}[$__range])) / sum(increase(st_chat_turns_total{deployment_environment_name=\"production\", lane=~\"$lane\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.97
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "首发成功率",
      "description": "首发模型自己的表现。报错：出字前就失败（含由兜底交付的）；中断：出字后卡住/流内错误/断开/被截断；拒答：正文开头命中运营词池或供应商内容过滤；超时：首字兜底真正替它交付，或谁都没出字。",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "sum(increase(st_chat_turns_total{deployment_environment_name=\"production\", lane=~\"$lane\", primary_outcome=\"success\"}[$__range])) / sum(increase(st_chat_turns_total{deployment_environment_name=\"production\", lane=~\"$lane\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.97
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "聊天轮数",
      "description": "时间范围内用户发起的聊天（含重新生成）；Prometheus 按采样外推，可能带小数误差。",
      "gridPos": {
