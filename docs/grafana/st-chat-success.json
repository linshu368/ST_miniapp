      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "sum(increase(st_chat_turns_total{deployment_environment_name=\"production\", lane=~\"$lane\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "兜底救回的轮数",
      "description": "首发失败、由首字兜底或出字后重写救回、用户最终拿到正常回答的轮数。",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "sum(increase(st_chat_turns_total{deployment_environment_name=\"production\", lane=~\"$lane\", outcome=\"success\", rescue!=\"none\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "成功率走势（近 1 小时滚动）",
      "description": "用户成功率 vs 首发成功率；两条线之间的差就是兜底救回的部分。",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "interval": "5m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "sum(increase(st_chat_turns_total{deployment_environment_name=\"production\", lane=~\"$lane\", outcome=\"success\"}[1h])) / sum(increase(st_chat_turns_total{deployment_environment_name=\"production\", lane=~\"$lane\"}[1h]))",
          "legendFormat": "用户成功率",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "B",
          "expr": "sum(increase(st_chat_turns_total{deployment_environment_name=\"production\", lane=~\"$lane\", primary_outcome=\"success\"}[1h])) / sum(increase(st_chat_turns_total{deployment_environment_name=\"production\", lane=~\"$lane\"}[1h]))",
          "legendFormat": "首发成功率",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "用户成功率"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "首发成功率"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "视图 1 · 每个模型的用户失败率（直接对应用户体验）",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "每个模型的用户失败率（按失败类型分色）",
      "description": "用户视角：首发 + 首字兜底 + 出字后重写共同作用之后，用户最终没拿到正常回答的比例。 模型按用户所选模型对应的首发平台 + 模型列出；受顶部「失败类型」筛选。",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "expr": "label_join(((sum by (platform, model, outcome) (increase(st_chat_turns_total{deployment_environment_name=\"production\", lane=~\"$lane\", outcome=~\"$fail_type\"}[$__range]))) or label_replace(0 * sum by (platform, model) (increase(st_chat_turns_total{deployment_environment_name=\"production\", lane=~\"$lane\"}[$__range])), \"outcome\", \"none\", \"\", \"\")) / on (platform, model) group_left sum by (platform, model) (increase(st_chat_turns_total{deployment_environment_name=\"production\", lane=~\"$lane\"}[$__range])), \"pm\", \" · \", \"platform\", \"model\")",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "outcome",
            "rowField": "pm",
            "valueField": "Value",
            "emptyValue": "zero"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "none": true
            },
            "renameByName": {
              "pm\\outcome": "模型",
              "error": "报错",
              "interrupted": "中断",
              "refused": "拒答",
              "timeout": "超时"
            },
            "indexByName": {
              "模型": 0,
              "报错": 1,
              "中断": 2,
              "拒答": 3,
              "超时": 4
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "reducer": "sum"
            },
            "alias": "合计",
            "replaceFields": false
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "合计",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "合计": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "报错"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "中断"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "拒答"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "超时"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "xField": "模型",
        "showValue": "never",
        "groupWidth": 0.75,
        "barWidth": 0.9,
        "barRadius": 0,
        "xTickLabelMaxLength": 40,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
