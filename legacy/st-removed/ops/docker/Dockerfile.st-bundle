# syntax=docker/dockerfile:1

# =============================================================================
# st-bundle: SillyTavern + provision-api + watcher in a single container,
# orchestrated by s6-overlay v3 (three longrun services).
#
# Decisions (hard constraints, see P1-2 deploy prompt M1):
#   - base: node:20-bookworm-slim (glibc + s6 first-class support; matches .nvmrc=20)
#   - multi-stage: builder-ext (st-extension) / builder-deps (sync-engine) / runtime
#   - dependencies installed inside the image (cross-platform safety)
#   - production config.yaml copied at build time (config-as-code)
#   - HEALTHCHECK probes ST(8000) + provision-api(9091); watcher(9090) health is
#     validated in M4 integration (watcher only stays up once real tg- users exist).
# =============================================================================

# ========== Stage 1: build st-extension ==========
FROM node:20-bookworm-slim AS builder-ext
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /build
# workspace 元信息 + 构建 st-extension 需要的包源码
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/st-extension     packages/st-extension
COPY packages/bridge-protocol  packages/bridge-protocol
COPY packages/shared           packages/shared
# vendor 也需要：postbuild.ts 把产物拷到 vendor/.../third-party/miniapp-bridge/
COPY vendor/sillytavern        vendor/sillytavern

RUN pnpm install --frozen-lockfile --filter @miniapp/st-extension...
RUN pnpm --filter @miniapp/st-extension build

# 构建期断言：扩展产物落到 vendor 目录（核验 2 实测路径）
RUN test -d /build/vendor/sillytavern/public/scripts/extensions/third-party/miniapp-bridge \
 && test -f /build/vendor/sillytavern/public/scripts/extensions/third-party/miniapp-bridge/entry.global.js \
 && test -f /build/vendor/sillytavern/public/scripts/extensions/third-party/miniapp-bridge/manifest.json

# ---- 第三方扩展「酒馆助手」(JS-Slash-Runner, pin v4.8.7) ----
# 受 git 跟踪的运行产物快照在 ops/st-extensions/，安装脚本幂等落地到 vendor 的 third-party
# 目录（bundle/ → dist/，绕开本 .dockerignore 的 **/dist）。third-party 是产物/脚本安装，不入库。
COPY scripts/install-st-extension.mjs scripts/install-st-extension.mjs
COPY ops/st-extensions ops/st-extensions
RUN node scripts/install-st-extension.mjs

# 构建期断言：酒馆助手运行文件（含 lib/ 硬依赖）落到 vendor（仿 miniapp-bridge）
RUN test -f /build/vendor/sillytavern/public/scripts/extensions/third-party/JS-Slash-Runner/manifest.json \
 && test -f /build/vendor/sillytavern/public/scripts/extensions/third-party/JS-Slash-Runner/dist/index.js \
 && test -f /build/vendor/sillytavern/public/scripts/extensions/third-party/JS-Slash-Runner/dist/index.css \
 && test -f /build/vendor/sillytavern/public/scripts/extensions/third-party/JS-Slash-Runner/lib/jsoneditor.js \
 && test -f /build/vendor/sillytavern/public/scripts/extensions/third-party/JS-Slash-Runner/lib/tailwindcss.min.js

# Install ST's OWN production dependencies inside the image (cross-platform safety),
# mirroring vendor/sillytavern/Dockerfile: `npm ci --omit=dev` then precompile public libs.
# (.dockerignore strips host node_modules from the build context, so ST has no deps until
#  this step; without it server.js fails with "Cannot find module 'express'".)
WORKDIR /build/vendor/sillytavern
RUN npm ci --no-audit --no-fund --loglevel=error --no-progress --omit=dev --ignore-scripts \
 && node ./docker/build-lib.js \
 && npm cache clean --force
RUN test -d /build/vendor/sillytavern/node_modules/express

# ---- 发布级资产命名空间（缓存保鲜根治）----
# 把 index.html 的 <base href="/"> 改为 /st-runtime/<内容哈希>/：整个 ST 模块图
# （script.js 及所有相对 import、CSS、字体）的 URL 每次发版自动变化，从缓存键层面
# 绕开 WebView（WebKit 无视 no-cache 的内存/预加载缓存）与 Vercel 边缘的旧副本。
# nginx 侧 `location ~ ^/st-runtime/` 剥掉前缀后按原有 location 分档（见 ops/nginx）。
# 仓库内 vendor/index.html 不改动（本地 dev 仍用 base "/"），仅镜像副本被改写。
RUN set -eux; \
    RUNTIME_BUILD_ID="$(find public -type f \( -name '*.js' -o -name '*.css' -o -name '*.html' \) -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-12)"; \
    test -n "${RUNTIME_BUILD_ID}"; \
    # e3b0c44298fc = 空输入的 sha256 前缀：管道静默失败时会得到它，必须拦截。
    test "${RUNTIME_BUILD_ID}" != "e3b0c44298fc"; \
    sed -i "s|<base href=\"/\">|<base href=\"/st-runtime/${RUNTIME_BUILD_ID}/\">|" public/index.html; \
    grep -Fq "/st-runtime/${RUNTIME_BUILD_ID}/" public/index.html

WORKDIR /build

# ========== Stage 2: install sync-engine deps ==========
FROM node:20-bookworm-slim AS builder-deps
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /build
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/sync-engine     packages/sync-engine
COPY packages/shared          packages/shared
COPY packages/bridge-protocol packages/bridge-protocol
COPY packages/db-types        packages/db-types

# 核验 1：tsx 在 sync-engine 的 devDependencies，因此 install 不能带 --prod，
# 也不能 prune --prod，否则运行时 tsx not found。
RUN pnpm install --frozen-lockfile --filter @miniapp/sync-engine...

# 构建期断言：tsx 可执行入口存在
RUN test -f /build/packages/sync-engine/node_modules/tsx/dist/cli.mjs

# ========== Stage 3: runtime ==========
FROM node:20-bookworm-slim

# --- 系统依赖 ---
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates xz-utils tini chromium \
 && rm -rf /var/lib/apt/lists/*

# --- s6-overlay v3 ---
ARG S6_OVERLAY_VERSION=3.2.0.0
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64)  S6_ARCH=x86_64  ;; \
      arm64)  S6_ARCH=aarch64 ;; \
      *) echo "unsupported arch: ${TARGETARCH}"; exit 1 ;; \
    esac; \
    curl -fSL "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz" \
      | tar -C / -Jxpf -; \
    curl -fSL "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-${S6_ARCH}.tar.xz" \
      | tar -C / -Jxpf -

# s6 行为配置
ENV S6_KEEP_ENV=1 \
    S6_BEHAVIOUR_IF_STAGE2_FAILS=2 \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=60000

# Debian Chromium needs writable XDG directories for its crashpad database when
# launched by the non-root node user in Railway's container runtime.
ENV XDG_CONFIG_HOME=/tmp/.chromium \
    XDG_CACHE_HOME=/tmp/.chromium

# --- ST runtime behavior ---
# NODE_ENV=production mirrors the vendor SillyTavern Dockerfile.
ENV NODE_ENV=production
# Keep the ST cookie-session name stable across Railway container replacements.
# `session` is also accepted by the frontend bridge cookie whitelist.
ENV ST_SESSION_COOKIE_NAME=session
# The 6 prescribed config overrides set listen=true + whitelistMode=false, which trips
# ST's security guard (verifySecuritySettings) when the default admin user has no password:
# ST refuses to start unless basicAuth/whitelist is on OR securityOverride is set. In this
# deploy the ST port (8000) is never publicly exposed — it sits behind the platform proxy /
# private network (M3/M4), so we acknowledge the exposed-listen posture via env override.
# Set via env (ST reads SILLYTAVERN_* before config.yaml) so config.production.yaml stays at
# exactly the 6 prescribed overrides. This is a behavior flag, NOT a secret.
ENV SILLYTAVERN_SECURITYOVERRIDE=true

# --- 应用文件 ---
WORKDIR /home/node/app

# provision 为每个 Telegram 用户下发的固定主题与背景资源。
COPY ops/st-platform-assets /home/node/app/ops/st-platform-assets
ENV PLATFORM_ASSETS_ROOT=/home/node/app/ops/st-platform-assets
RUN test -f "$PLATFORM_ASSETS_ROOT/themes/Glimmer - by Rivelle.json" \
 && test -f "$PLATFORM_ASSETS_ROOT/backgrounds/night-city-anime.jpg"

# ST 本体（含 builder-ext 注入的扩展）
COPY --from=builder-ext /build/vendor/sillytavern /home/node/app

# sync-engine 源码 + 其工作区依赖 + 根 node_modules（pnpm .pnpm store）
# 注：pnpm 把依赖以相对符号链接 (../../../node_modules/.pnpm/...) 散落在
# packages/*/node_modules 与根 node_modules 之间；保持同样的目录拓扑即可解析。
# @miniapp/shared 是 sync-engine 唯一的工作区依赖 (packages/sync-engine/node_modules/@miniapp/shared -> ../../../shared)。
COPY --from=builder-deps /build/packages/sync-engine /home/node/app/packages/sync-engine
COPY --from=builder-deps /build/packages/shared       /home/node/app/packages/shared
COPY --from=builder-deps /build/node_modules          /home/node/app/node_modules

# 生产 config.yaml（server.js 默认读 ./config.yaml，相对 serverDirectory=/home/node/app）
COPY ops/sillytavern/config.production.yaml /home/node/app/config.yaml

# s6 service 定义
COPY ops/s6 /etc/s6-overlay/s6-rc.d
# Local `railway up` can upload CRLF line endings from Windows; s6 run scripts
# must stay LF-only or the shebang becomes `/usr/bin/env bash\r`.
RUN find /etc/s6-overlay/s6-rc.d -type f -exec sed -i 's/\r$//' {} \;

# --- 数据目录 + 权限 ---
# node:20-bookworm-slim 自带 uid=1000 的 node 用户；ST 与 sync-engine 均以 node 运行。
RUN mkdir -p /home/node/app/data /home/node/app/config \
             /home/node/app/plugins /home/node/app/extensions /home/node/app/backups \
             /home/node/app/public/scripts/extensions/third-party \
 && chown -R node:node /home/node/app

# --- 端口 + volume ---
EXPOSE 8000 9091 9090


# --- Healthcheck（决策：探 ST + provision-api；watcher 9090 留 M4）---
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/ >/dev/null \
   && curl -fsS http://127.0.0.1:9091/health >/dev/null \
   || exit 1

# s6-overlay 作为 PID 1
ENTRYPOINT ["/init"]
