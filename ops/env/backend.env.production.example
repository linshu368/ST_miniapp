# =============================================================================
# backend（Railway 服务 `backend`）生产环境变量模板 — 方案 Y
# -----------------------------------------------------------------------------
# 来源：packages/backend/src/**（process.env.*）+ prisma/schema.prisma。
# 在 Railway 控制台该服务的 Variables 中配置；密钥类只在控制台注入，勿提交真实值。
# 标注：[必填] 进程启动/核心链路所需；[功能] 仅对应功能用到时需要。
# =============================================================================

# ── 运行时 ───────────────────────────────────────────────────────────────────
NODE_ENV=production                 # [必填]
PORT=3001                           # [必填] 监听端口；须与 Railway 路由到容器的端口一致
CHAT_HISTORY_SYNC_ENABLED=true      # [功能] OpenRouter 用量回捞定时任务开关

# ── Sentry 后端观测（与前端共用同一 Sentry Project）──────────────────────────
SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=<git-commit-sha>      # 可选；不设则使用 Railway RAILWAY_GIT_COMMIT_SHA

# ── Supabase 连接（service_role；隔离守卫按 DATABASE_ENV 选择变量组）──────────
DATABASE_ENV=production             # [必填] production → 使用 PROD_* 组并校验 PROD ref
# 标准变量（也可只填 PROD_* 组，启动时自动覆盖这四个）：
SUPABASE_URL=                       # [必填] https://<prod-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # [必填] service_role key（绕过 RLS）
DATABASE_URL=                       # [必填] Postgres 连接串（pgbouncer:6543）；空则 Prisma 启动即抛
DIRECT_URL=                         # [迁移] 直连 5432（迁移用，运行时查询不读）
# 生产主库变量组（DATABASE_ENV=production 时自动启用并做 ref 隔离校验）：
PROD_SUPABASE_PROJECT_REF=          # [必填] 生产 project ref
PROD_SUPABASE_URL=                  # [必填] https://<prod-ref>.supabase.co
PROD_SUPABASE_SERVICE_ROLE_KEY=    # [必填] 生产 service_role key
PROD_DATABASE_URL=                  # [必填] 生产 Postgres 串（:6543?pgbouncer=true）
PROD_DIRECT_URL=                    # [迁移] 生产直连（:5432）

# ── LLM 上游（唯一出口在 backend 进程内）─────────────────────────────────────
LLM_UPSTREAM_URL=https://openrouter.ai/api/v1   # [功能] 上游 LLM provider（OpenAI 兼容）
LLM_API_KEY=                        # [功能] 平台持有的上游 key，只在 backend 进程内；缺省回退 OPENAI_API_KEY

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://<your-vercel-domain>   # [必填] 对外域名（Vercel）；精确匹配 CORS origin
CS_PLATFORM_URL=https://st-cs-platform.vercel.app
ADMIN_PLATFORM_URL=https://st-admin-platform.vercel.app

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                 # [功能] TG init-data 校验
TELEGRAM_WEBHOOK_SECRET=            # [功能] Telegram setWebhook secret_token；校验 /api/telegram/webhook
BOT_INTERNAL_SECRET=                # [功能] 服务内部写入 bot /start 的备用接口密钥
TELEGRAM_COMMUNITY_BOT_TOKEN=       # [功能] 官方社群成员事件与成员查询专用 Bot
CS_TELEGRAM_BOT_TOKEN=              # [兼容回退] 仅 TELEGRAM_BOT_TOKEN 为空时用于 CS 回访；通常留空

# ── 支付（子千易 V2 RSA；默认关闭）───────────────────────────────────────────
PAYMENT_ENABLED=false               # [功能] =true 启用支付
PAYMENT_BASE_URL=https://zq.716faka.com
PAYMENT_MERCHANT_ID=                # [若启用] 子千易商户 ID
PAYMENT_MERCHANT_PRIVATE_KEY=       # [若启用] 商户 RSA 私钥
PAYMENT_PLATFORM_PUBLIC_KEY=        # [若启用] 平台 RSA 公钥
PAYMENT_NOTIFY_URL=https://<your-backend-domain>/api/payment/webhook/zqpay # [若启用]
PAYMENT_RETURN_URL=https://<your-backend-domain>/api/payment/return        # [若启用]

# ── 其他（可选）──────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=             # [可选] 运行时配置缓存
UPSTASH_REDIS_REST_TOKEN=           # [可选]
