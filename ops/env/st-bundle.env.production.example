# =============================================================================
# st-bundle（Railway 服务 `st-bundle`）生产环境变量模板 — 方案 Y
# -----------------------------------------------------------------------------
# st-bundle = SillyTavern（ST）+ sync-engine（provision-api + watcher），s6 同容器。
# 变量来源：packages/sync-engine/.env.example + src/lib/config.ts（zod schema）。
# 在 Railway 控制台该服务的 Variables 中配置；密钥类只在控制台注入。
# =============================================================================

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ ⚠️ 跨服务逐字一致密钥（必须与 backend 服务**完全相同**，否则鉴权/扣费断）  ║
# ║   - ST_USER_PASSWORD_SECRET   （派生每个 ST 用户登录密码的 HMAC 密钥）       ║
# ║   - LLM_PROXY_TOKEN_SECRET    （签发/验签 LLM 代理 token 的密钥）            ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
ST_USER_PASSWORD_SECRET=            # [必填] 与 backend 逐字一致
LLM_PROXY_TOKEN_SECRET=             # [必填] 与 backend 逐字一致

# ── provision-api 绑定（务必显式设置）────────────────────────────────────────
# ⚠️ 必须 0.0.0.0：默认绑 127.0.0.1，**不设会导致 backend 跨服务调不到 provision-api**。
PROVISION_API_BIND_HOST=0.0.0.0     # [必填]
PROVISION_API_PORT=9091             # [必填] 与 backend ST_PROVISION_URL 端口一致
HEALTH_PORT=9090                    # [必填] watcher 健康检查端口（仅内网）

# ── 运行时 ───────────────────────────────────────────────────────────────────
NODE_ENV=production                 # [必填]
DATABASE_ENV=production             # [必填] production → 使用 PROD_* 组并做 ref 隔离校验
LOG_LEVEL=info                      # [可选]

# ── Supabase（service_role）──────────────────────────────────────────────────
SUPABASE_URL=                       # [必填] https://<prod-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # [必填] service_role key
PROD_SUPABASE_PROJECT_REF=          # [必填] 生产 project ref（隔离校验）
PROD_SUPABASE_URL=                  # [必填] https://<prod-ref>.supabase.co
PROD_SUPABASE_SERVICE_ROLE_KEY=    # [必填] 生产 service_role key
# 角色卡 PNG 的 Supabase Storage bucket（provisioner 从这里拉取下发到 ST）。
CHARACTER_STORAGE_BUCKET=character-assets   # [必填]

# ── ST 数据目录（== 镜像 VOLUME == Railway 卷挂载点）─────────────────────────
ST_DATA_PATH=/home/node/app/data    # [必填] 与 railway 卷 Mount path 一致

# ── ST 管理员账号（sync-engine 调 ST POST /api/users/create 建用户）──────────
ST_BASE_URL=http://localhost:8000   # [必填] 同容器内 ST 地址（s6 同容器，走本地回环）
ST_ADMIN_USERNAME=admin             # [必填]
ST_ADMIN_PASSWORD=                  # [必填] ST 管理员密码

# ── LLM 代理地址（provision 写入 ST settings 的 reverse_proxy）────────────────
# 指向 Railway 内网 backend 服务的代理网关（ST 进程须可达）。
# backend 的 Railway 服务名为 `stminiapp`，监听 8080。
LLM_PROXY_URL=http://stminiapp.railway.internal:8080/api/platform/llm-proxy/v1   # [必填]
