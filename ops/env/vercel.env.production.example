# =============================================================================
# Vercel（前端）生产环境变量模板 — 方案 Y
# -----------------------------------------------------------------------------
# 在 Vercel 项目 Settings → Environment Variables 中配置（Production 环境）。
# 前端只放「公开 / 路由所需」变量；密钥类（TELEGRAM_BOT_TOKEN / LLM_API_KEY /
# SUPABASE_SERVICE_ROLE_KEY 等）前端不直接用 → **不要放这里**（它们属于 backend /
# st-bundle，见对应模板）。NEXT_PUBLIC_* 会被打进客户端 bundle，切勿放敏感值。
# =============================================================================

# ── ST 反代入口（方案 Y 核心）────────────────────────────────────────────────
# Railway nginx 对外可达地址（Railway 自带域名或二级域名）。next.config.mjs 在此变量
# 存在时启用生产 rewrites，把 /tavern/*、ST /api/*、/api/platform/* 转发到这里。
# 必填。形如 https://st-miniapp-nginx-production.up.railway.app（末尾不带 /）。
ST_PUBLIC_PROXY_URL=https://<railway-nginx-domain>

# ── 前端运行时公开变量（NEXT_PUBLIC_*，build 期固化进 bundle）─────────────────
# 浏览器侧 API base。留空 = 同源相对路径（推荐：/api/... 由 Vercel rewrites/同源处理）。
NEXT_PUBLIC_API_URL=
# 生产关闭所有 mock（务必为 0/unset）。
NEXT_PUBLIC_USE_MOCK=0
NEXT_PUBLIC_USE_MOCK_INIT_DATA=0

# ── Sentry 浏览器监控 ─────────────────────────────────────────────────────────
# DSN 是公开的项目写入地址，不是密钥；生产环境值必须显式为 production。
NEXT_PUBLIC_SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Source Map 上传配置。AUTH_TOKEN 是构建密钥，只配置在 Vercel，绝不能添加 NEXT_PUBLIC_。
SENTRY_ORG=<sentry-org-slug>
SENTRY_PROJECT=<sentry-project-slug>
SENTRY_AUTH_TOKEN=<sentry-org-auth-token>
# 可选：不设置时构建会使用 Vercel 提供的 VERCEL_GIT_COMMIT_SHA。
SENTRY_RELEASE=<git-commit-sha>

# Vercel Development（dev 分支）需配置同一组变量，仅将环境改为：
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ── 仅供参考（前端通常无需）────────────────────────────────────────────────
# 对外域名。CORS 由 backend 用（backend 自己的 FRONTEND_URL，见 backend 模板）。
# Vercel 侧一般不需要；如某些前端逻辑要读对外域名再启用。
# FRONTEND_URL=https://<your-vercel-domain>
