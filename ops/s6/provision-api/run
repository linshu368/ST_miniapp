#!/command/with-contenv bash
# provision-api process. Depends on st (dependencies.d/st), then waits for ST to actually
# accept connections on :8000 before starting (s6 dependency only guarantees "started",
# not "listening").
set -e

echo "[provision-api] waiting for ST on 127.0.0.1:8000 ..."
for i in $(seq 1 90); do
  if curl -fsS -m 1 http://127.0.0.1:8000/ >/dev/null 2>&1; then
    echo "[provision-api] ST is ready after ${i}s"
    break
  fi
  sleep 1
done

cd /home/node/app/packages/sync-engine
# Invoke tsx's cli.mjs directly (via the pnpm symlink) to avoid the install-time bin shim
# which hardcodes absolute NODE_PATH from the build stage.
exec s6-setuidgid node ./node_modules/tsx/dist/cli.mjs src/provision-api/run.ts
