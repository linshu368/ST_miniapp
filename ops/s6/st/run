#!/command/with-contenv bash
# ST main process. Replicates vendor docker-entrypoint.sh dir-init, then runs node server.js.
# Runs as root (PID-managed by s6), drops to the `node` user for the server itself.
set -e
cd /home/node/app

# === Replicate vendor docker-entrypoint.sh CORE_DIRS initialization ===
# Vendor ensures these exist for volumeless / empty-volume cold starts.
for dir in config data plugins public/scripts/extensions/third-party backups; do
  mkdir -p "$dir"
done
# Fix ownership in case a fresh volume mounted as root over these paths.
chown -R node:node config data plugins public/scripts/extensions/third-party backups || true

# config.production.yaml was copied to /home/node/app/config.yaml at build time, so the
# vendor "copy default/config.yaml -> config/config.yaml" + "npm run init" steps are not
# needed (our config.yaml is already the full vendor schema). server.js reads ./config.yaml
# (relative to serverDirectory) by default; config has listen=true/port=8000 but we still
# pass --listen for parity with the vendor entrypoint.
exec s6-setuidgid node node server.js --listen
