#!/command/with-contenv bash
# watcher process. Depends on st (dependencies.d/st), then waits for ST to accept
# connections on :8000 before starting.
set -e

if [[ "${DISABLE_WATCHER:-0}" == "1" ]]; then
  echo "[watcher] disabled for this deployment"
  exec sleep infinity
fi

echo "[watcher] waiting for ST on 127.0.0.1:8000 ..."
for i in $(seq 1 90); do
  if curl -fsS -m 1 http://127.0.0.1:8000/ >/dev/null 2>&1; then
    echo "[watcher] ST is ready after ${i}s"
    break
  fi
  sleep 1
done

cd /home/node/app/packages/sync-engine
# Invoke tsx's cli.mjs directly (via the pnpm symlink) to avoid the install-time bin shim
# which hardcodes absolute NODE_PATH from the build stage.
exec s6-setuidgid node ./node_modules/tsx/dist/cli.mjs src/watcher/run.ts
