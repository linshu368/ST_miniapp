{
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:frontend": "pnpm --filter @miniapp/frontend dev",
    "dev:cs-platform": "pnpm --filter @miniapp/cs-platform dev",
    "dev:backend": "pnpm --filter @miniapp/backend dev",
    "dev:provision": "pnpm --filter @miniapp/sync-engine start:provision",
    "dev:watcher": "pnpm --filter @miniapp/sync-engine watch",
    "st-ext:install": "node scripts/install-st-extension.mjs",
    "predev:st": "node scripts/install-st-extension.mjs",
    "dev:st": "cd vendor/sillytavern && node server.js",
    "dev": "pnpm run --parallel dev:frontend dev:backend",
    "dev:all": "concurrently -n st,prov,watch,be,fe -c blue,magenta,yellow,green,cyan \"pnpm dev:st\" \"pnpm dev:provision\" \"pnpm dev:watcher\" \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "lint:imports": "eslint --no-eslintrc -c .eslintrc.json 'packages/*/src/**/*.{ts,tsx}' --rule '{}' --ignore-pattern '**/__tests__/eslint-import-guard.ts' --no-inline-config",
    "import-character": "pnpm --filter @miniapp/sync-engine exec tsx ../../scripts/import-character.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.62.0",
    "concurrently": "^10.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@prisma/client",
      "prisma",
      "unrs-resolver",
      "esbuild"
    ]
  }
}
