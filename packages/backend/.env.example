# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# Batch Lab 独立 SPA 的精确 origin；不要填写通配符。
BATCH_LAB_URL=http://localhost:3004
BATCH_LAB_ENABLED=false
# V1 由 Backend 部署固定来源，UI 只读显示。
BATCH_LAB_SAMPLE_SOURCE_ENV=test
# 仅后端使用的来源库只读连接；用户必须为 batch_lab_source_login。T3 接入前保持未配置。
# 禁止提交真实 URI，禁止复用 DATABASE_URL/postgres/service-role，禁止放入 VITE_*/NEXT_PUBLIC_*。
BATCH_LAB_SOURCE_DATABASE_URL=postgresql://batch_lab_source_login.<test-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
# 仅 production 来源可设置；test/development 不得设置。
BATCH_LAB_ALLOW_PRODUCTION_SOURCE=false
# 连接建立超时 500..10000ms；来源连接池上限 1..5。
BATCH_LAB_SOURCE_CONNECT_TIMEOUT_MS=3000
BATCH_LAB_SOURCE_MAX_CONNECTIONS=2

# ─── 数据库环境隔离 ─────────────────────────────────────────────────────────
# development / test / production
# - test 必须连接 TEST_SUPABASE_PROJECT_REF
# - production 必须连接 PROD_SUPABASE_PROJECT_REF
# - 非 production 默认禁止连接 PROD_SUPABASE_PROJECT_REF
# - 启动时会按 DATABASE_ENV 自动选择 TEST_* 或 PROD_* 变量组
DATABASE_ENV=test

# 测试分支变量组：development / test 环境自动使用。
TEST_SUPABASE_PROJECT_REF=zoqelpfhurwehlvypryl
TEST_DATABASE_URL=postgresql://postgres.<test-ref>:<password>@<host>:6543/postgres?pgbouncer=true
TEST_DIRECT_URL=postgresql://postgres.<test-ref>:<password>@<host>:5432/postgres
TEST_SUPABASE_URL=https://zoqelpfhurwehlvypryl.supabase.co
TEST_SUPABASE_SERVICE_ROLE_KEY=

# 生产主库变量组：production 环境自动使用。
PROD_SUPABASE_PROJECT_REF=wbtsfzozlmurljvglhpn
PROD_DATABASE_URL=postgresql://postgres.<prod-ref>:<password>@<host>:6543/postgres?pgbouncer=true
PROD_DIRECT_URL=postgresql://postgres.<prod-ref>:<password>@<host>:5432/postgres
PROD_SUPABASE_URL=https://wbtsfzozlmurljvglhpn.supabase.co
PROD_SUPABASE_SERVICE_ROLE_KEY=

# 兼容旧部署变量。自动切换会在启动时覆盖这些标准变量。
DATABASE_URL=
DIRECT_URL=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 仅紧急人工操作时使用。应用服务不要配置。
# ALLOW_PROD_DATABASE=true

# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BOT_INTERNAL_SECRET=
TELEGRAM_COMMUNITY_BOT_TOKEN=

# ─── CS Platform 内部回访工作台 ─────────────────────────────────────────────
# 前端调用 /api/cs/* 时必须通过 X-CS-Admin-Token 携带。
CS_ADMIN_TOKEN=
# Telegram webhook 回流用户回复时使用 X-CS-Webhook-Secret 校验。
CS_TELEGRAM_WEBHOOK_SECRET=

# ─── LLM 代理网关（ST 的 LLM endpoint 指向此处）─────────────────────────────
# 上游 LLM provider 地址（OpenRouter / OpenAI 等 OpenAI 兼容接口）
LLM_UPSTREAM_URL=https://openrouter.ai/api/v1
# 平台持有的 API key（不暴露给 ST 前端）
LLM_API_KEY=
LLM_DEFAULT_MODEL=google/gemini-2.5-flash
# 代理网关 token 签发/验签密钥（代码用此变量，见 src/lib/llm-token.ts）。
# 缺省回退到 ST_USER_PASSWORD_SECRET；必须与 sync-engine 逐字一致。
LLM_PROXY_TOKEN_SECRET=

# ─── 角色语音 ───────────────────────────────────────────────────────────────
# 聊天页「生成语音」用。两段式：DeepSeek 写稿 + MiniMax 合成，是两把不同的 key。
# 任意一把留空，该功能整体不可用（接口返回 503），其余功能不受影响。
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
# 下面几项有默认值，仅在换端点或换模型时才需要覆盖。
# DEEPSEEK_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-v4-flash
# MINIMAX_TTS_URL=https://api.minimaxi.com/v1/t2a_v2
# MINIMAX_TIMEOUT_MS=120000

# ─── 聊天图片生成 ───────────────────────────────────────────────────────────
# 主通道 Grok/Liaobots；主通道失败时降级到 Replicate Z 模型。两种 token 都只放后端。
LIAOBOTS_AUTH=
REPLICATE_TOKEN=
# LIAOBOTS_BASE=https://ai.liaobots1.work
# GROK_MODEL=grok-imagine-image-quality
# REPLICATE_BASE=https://api.replicate.com/v1
# Z_MODEL=prunaai/z-image-turbo
# IMAGE_GENERATION_TIMEOUT_MS=180000
# IMAGE_DOWNLOAD_TIMEOUT_MS=60000
# IMAGE_WORKER_ENABLED=true

# ─── ST / sync-engine ───────────────────────────────────────────────────────
ST_BASE_URL=http://localhost:8000
ST_USER_PASSWORD_SECRET=
ST_PROVISION_URL=http://127.0.0.1:9091

# ─── 平台默认头像 ───────────────────────────────────────────────────────────
# 各环境的 Supabase 项目不同，留空则回退到测试环境地址。
# 生产必须指向 PROD_SUPABASE_URL 下的 miniapp-user-avatars/default_user_avatar/。
DEFAULT_USER_AVATAR_URL=

# ─── MiniApp 支付 ───────────────────────────────────────────────────────────
PAYMENT_ENABLED=false
PAYMENT_BASE_URL=https://zq.716faka.com
PAYMENT_MERCHANT_ID=
PAYMENT_MERCHANT_PRIVATE_KEY=
PAYMENT_PLATFORM_PUBLIC_KEY=
PAYMENT_NOTIFY_URL=https://<miniapp-backend-domain>/api/payment/webhook/zqpay
PAYMENT_RETURN_URL=https://<miniapp-backend-domain>/api/payment/return
