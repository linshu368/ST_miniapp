{
  "name": "@miniapp/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "npx prisma generate && tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:macros": "tsc --noEmit -p src/prompt-engine/macros/tsconfig.json",
    "typecheck:instruct": "tsc --noEmit -p src/prompt-engine/instruct/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "macros:baseline": "tsx scripts/run-miniapp-baseline.mjs",
    "macros:diff": "node scripts/diff-baselines.mjs",
    "macros:verify": "tsx scripts/run-miniapp-baseline.mjs && node scripts/diff-baselines.mjs",
    "instruct:baseline": "tsx scripts/run-miniapp-instruct-baseline.mjs",
    "instruct:diff": "node scripts/diff-instruct-baselines.mjs",
    "instruct:verify": "tsx scripts/run-miniapp-instruct-baseline.mjs && node scripts/diff-instruct-baselines.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@miniapp/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "chevrotain": "^11.1.1",
    "dotenv": "^16.4.0",
    "droll": "^0.2.1",
    "fastify": "^5.2.0",
    "moment": "^2.30.1",
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/seedrandom": "^3.0.8",
    "@vitest/coverage-v8": "^4.1.5",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  }
}
