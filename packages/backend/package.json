{
  "name": "@miniapp/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/server.ts",
    "start": "npx prisma generate && tsx --import ./src/instrumentation.ts src/server.ts",
    "payment:expire-orders": "tsx src/scripts/expire-payment-orders.ts",
    "payment:reconcile-orders": "tsx src/scripts/reconcile-payment-orders.ts",
    "payment:diagnose-query": "tsx src/scripts/diagnose-zqpay-query.ts",
    "payment:callback-report": "tsx src/scripts/payment-callback-report.ts",
    "vip:send-expiry-reminders": "tsx src/scripts/send-vip-expiry-reminders.ts",
    "image-plaza:seed": "tsx src/scripts/import-image-plaza-seed.ts",
    "image-plaza:translate-seed-prompts": "tsx src/scripts/translate-image-plaza-seed-prompts.ts",
    "image-plaza:retry-failed-prompts-venice": "tsx src/scripts/translate-image-plaza-seed-prompts.ts --retry-failed --venice-model qwen-3-8-27b",
    "video-plaza:estimate-size": "tsx src/scripts/estimate-video-plaza-seed-size.ts",
    "video-plaza:seed": "tsx src/scripts/import-video-plaza-seed.ts",
    "video-plaza:seed-assets": "tsx src/scripts/process-video-plaza-seed-assets.ts",
    "video-plaza:seed-upload": "tsx src/scripts/upload-video-plaza-seed-assets.ts",
    "video-plaza:seed-sql": "tsx src/scripts/generate-video-plaza-seed-sql.ts",
    "video-plaza:seed-validate-playback": "tsx src/scripts/validate-video-plaza-seed-playback.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/infrastructure/repositories/conversations.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@miniapp/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.69.0",
    "@supabase/supabase-js": "^2.107.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.2.0",
    "https-proxy-agent": "7.0.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "tsx": "^4.19.0",
    "tus-js-client": "4.3.1",
    "undici": "7.16.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  }
}
