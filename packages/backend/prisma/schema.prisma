generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["miniapp"]
}

// 旧 bot 的 public.* 表不再由本项目声明：它们属于 bot 体系，日后会随 bot 迁出本 project。
// 需要读 bot 数据时走一次性 SQL，不要在这里加回 model。

model MiniappUser {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tg_id                 String                   @unique
  source_id             String?
  bot_entered_at        DateTime?                @db.Timestamptz(6)
  miniapp_entered_at    DateTime?                @db.Timestamptz(6)
  total_round           BigInt                   @default(0)
  st_handle             String                   @unique
  st_initialized_at     DateTime?                @db.Timestamptz(6)
  created_at            DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                 @default(now()) @db.Timestamptz(6)
  daily_checkins        daily_checkins[]
  miniapp_user_settings miniapp_user_settings?
  payment_orders        miniapp_payment_orders[]
  user_wallets          user_wallets?
  wallet_ledger         wallet_ledger[]
  wish_roles            wish_roles[]

  @@map("users")
  @@schema("miniapp")
}

model miniapp_user_settings {
  user_id                  String      @id @db.Uuid
  tg_username              String?
  tg_first_name            String?
  tg_last_name             String?
  display_name             String?
  avatar_url               String?
  tg_avatar_url            String?
  custom_avatar_url        String?
  total_round              BigInt      @default(0)
  pref_word_count          String      @default("300-500")
  pref_show_options        Boolean     @default(true)
  pref_custom_instructions String?
  created_at               DateTime    @default(now()) @db.Timestamptz(6)
  updated_at               DateTime    @default(now()) @db.Timestamptz(6)
  users                    MiniappUser @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("miniapp")
}

model Character {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String
  description               String    @default("")
  avatar_url                String    @default("")
  creator_notes             String    @default("")
  created_at                DateTime  @default(dbgenerated("timezone('Asia/Shanghai'::text, now())")) @db.Timestamp(6)
  updated_at                DateTime  @default(dbgenerated("timezone('Asia/Shanghai'::text, now())")) @db.Timestamp(6)
  alternate_greetings       Json      @default("[]")
  character_book            Json?
  character_version         String    @default("")
  creator                   String    @default("")
  extensions                Json      @default("{}")
  first_mes                 String    @default("")
  mes_example               String    @default("")
  personality               String    @default("")
  post_history_instructions String    @default("")
  scenario                  String    @default("")
  spec                      String    @default("chara_card_v2")
  spec_version              String    @default("2.0")
  system_prompt             String    @default("")
  tags                      Json      @default("[]")
  raw_card                  Json?
  enabled                   Boolean   @default(true)
  is_test                   Boolean   @default(false)
  card_hash                 String?
  sort_order                Int       @default(0)
  archived_at               DateTime? @db.Timestamp(6)
  last_listed_at            DateTime? @db.Timestamptz(6)

  @@map("characters")
  @@schema("miniapp")
}

model MiniappRuntimeConfig {
  key         String   @id
  value       Json?
  description String?
  version     Int?     @default(1)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  text_value  String?

  @@map("runtime_config")
  @@schema("miniapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model daily_checkins {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String      @db.Uuid
  reward_credits Int
  claimed_at     DateTime    @default(now()) @db.Timestamptz(6)
  users          MiniappUser @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, claimed_at(sort: Desc)], map: "idx_miniapp_daily_checkins_user_claimed")
  @@schema("miniapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model miniapp_payment_orders {
  id                      String      @id
  user_id                 String      @db.Uuid
  status                  String      @default("pending")
  payment_type            String
  amount_cents            Int
  credits_amount          Int
  bonus_credits           Int         @default(0)
  provider_transaction_id String?
  credits_added           Boolean     @default(false)
  created_at              DateTime    @default(now()) @db.Timestamptz(6)
  expires_at              DateTime    @db.Timestamptz(6)
  paid_at                 DateTime?   @db.Timestamptz(6)
  users                   MiniappUser @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_miniapp_payment_orders_status")
  @@index([user_id, created_at(sort: Desc)], map: "idx_miniapp_payment_orders_user_created")
  @@map("payment_orders")
  @@schema("miniapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_wallets {
  user_id           String      @id @db.Uuid
  main_credits      Decimal     @default(0) @db.Decimal(14, 1)
  bonus_credits     Decimal     @default(0) @db.Decimal(14, 1)
  created_at        DateTime    @default(now()) @db.Timestamptz(6)
  updated_at        DateTime    @default(now()) @db.Timestamptz(6)
  first_paid_at     DateTime?   @db.Timestamptz(6)
  last_paid_at      DateTime?   @db.Timestamptz(6)
  total_paid_amount Decimal     @default(0) @db.Decimal(12, 2)
  total_credits     Decimal?    @default(dbgenerated("(main_credits + bonus_credits)")) @db.Decimal(14, 1)
  users             MiniappUser @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("miniapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model wallet_ledger {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String      @db.Uuid
  entry_type     String
  amount         Decimal     @db.Decimal(14, 1)
  main_delta     Decimal     @default(0) @db.Decimal(14, 1)
  bonus_delta    Decimal     @default(0) @db.Decimal(14, 1)
  balance_main   Decimal     @db.Decimal(14, 1)
  balance_bonus  Decimal     @db.Decimal(14, 1)
  reference_type String?
  reference_id   String?
  metadata       Json        @default("{}")
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  users          MiniappUser @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([reference_type, reference_id], map: "idx_miniapp_wallet_ledger_reference")
  @@index([user_id, created_at(sort: Desc)], map: "idx_miniapp_wallet_ledger_user_created")
  @@schema("miniapp")
}

model llm_usage_charges {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  charge_key             String    @unique @db.Uuid
  generation_id          String?
  user_id                String    @db.Uuid
  model_id               String?
  model_openrouter_id    String
  model_display_name     String
  catalog_version        Int       @default(0)
  pricing_config_version Int       @default(0)
  usage_cost_usd         Decimal?  @db.Decimal(20, 10)
  exchange_rate          Decimal   @db.Decimal(14, 4)
  model_markup           Decimal   @db.Decimal(4, 1)
  initial_amount         Decimal   @default(0) @db.Decimal(14, 1)
  calculated_amount      Decimal   @default(0) @db.Decimal(14, 1)
  charged_amount         Decimal   @default(0) @db.Decimal(14, 1)
  fallback_used          Boolean   @default(false)
  status                 String
  debit_ledger_id        String?   @db.Uuid
  metadata               Json      @default("{}")
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)
  reconciled_at          DateTime? @db.Timestamptz(6)

  @@index([user_id, created_at(sort: Desc)], map: "idx_llm_usage_charges_user_created")
  @@index([model_openrouter_id, created_at(sort: Desc)], map: "idx_llm_usage_charges_model_created")
  @@schema("miniapp")
}

/// Minimal idempotency tombstones retained after full usage details exceed the per-user cap.
/// This model contains row level security and requires additional setup for migrations.
model llm_usage_charge_dedup {
  charge_key     String   @id @db.Uuid
  generation_id  String?
  user_id        String   @db.Uuid
  charged_amount Decimal  @default(0) @db.Decimal(14, 1)
  status         String
  processed_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, processed_at(sort: Desc)], map: "idx_llm_usage_charge_dedup_user_processed")
  @@schema("miniapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model wish_roles {
  id                          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                     BigInt
  db_user_id                  String?      @db.Uuid
  wish_text                   String
  extra_text                  String?
  total_paid_amount_at_submit Decimal      @default(0) @db.Decimal(12, 2)
  reward_credits              Int          @default(1)
  status                      String       @default("awaiting_extra")
  created_at                  DateTime     @default(now()) @db.Timestamptz(6)
  closed_at                   DateTime?    @db.Timestamptz(6)
  users                       MiniappUser? @relation(fields: [db_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, created_at(sort: Desc)], map: "idx_miniapp_wish_roles_status_created")
  @@index([user_id, created_at(sort: Desc)], map: "idx_miniapp_wish_roles_user_created")
  @@schema("miniapp")
}
