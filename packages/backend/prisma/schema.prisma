  status                                                             String
  wallet_ledger_id                                                   String?        @db.Uuid
  refund_ledger_id                                                   String?        @db.Uuid
  created_at                                                         DateTime       @default(now()) @db.Timestamptz(6)
  refunded_at                                                        DateTime?      @db.Timestamptz(6)
  wallet_ledger_chat_message_charges_refund_ledger_idTowallet_ledger wallet_ledger? @relation("chat_message_charges_refund_ledger_idTowallet_ledger", fields: [refund_ledger_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
