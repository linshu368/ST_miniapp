generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["miniapp", "public"]
}

model User {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tg_id                 String                 @unique(map: "users_tg_id_uniq")
  bonus_credits         Int                    @default(660)
  main_credits          Int?                   @default(0)
  total_credits         Int?                   @default(dbgenerated("(main_credits + bonus_credits)"))
  first_paid_at         DateTime?              @db.Timestamptz(6)
  last_paid_at          DateTime?              @db.Timestamptz(6)
  total_paid_amount     Decimal                @default(0) @db.Decimal(12, 2)
  source_id             String?
  last_checkin_at       DateTime?              @db.Timestamptz(6)
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @db.Timestamptz(6)
  app_sessions          AppSession[]
  miniapp_user_settings miniapp_user_settings?
  bot_user_settings     bot_user_settings?

  @@map("users")
  @@schema("public")
}

model Message {
  id                            Int       @id @default(autoincrement())
  user_id                       String
  role_id                       String?
  accept_at                     DateTime? @db.Timestamptz(6)
  instructions                  String?
  bot_reply                     String?
  history                       String?
  model_name                    String?
  user_input                    String?
  round                         Int?
  full_response                 Int?
  attempt_count                 Int?
  first_response_latency        Float?
  meta_model                    String?
  meta_generation_time          Float?
  meta_latency                  Float?
  meta_native_tokens_prompt     Int?
  meta_native_tokens_completion Int?
  meta_native_tokens_reasoning  Int?
  meta_native_tokens_cached     Int?
  meta_cache_discount           Float?
  meta_usage                    Json?
  meta_finish_reason            String?
  meta_provider_name            String?
  type                          String?
  trace_id                      String?
  session_id                    String?
  created_at                    DateTime? @db.Timestamptz(6)
  credits_deducted              Int?
  credits_account               String?
  user_preferences              Json?

  @@index([session_id], map: "idx_messages_session_id")
  @@index([accept_at], map: "idx_messages_timestamp")
  @@index([user_id, accept_at], map: "idx_messages_user_accept")
  @@index([user_id], map: "idx_messages_user_id")
  @@map("messages")
  @@schema("public")
}

model bot_user_settings {
  user_id                  String   @id @db.Uuid
  tg_username              String?
  tg_first_name            String?
  tg_last_name             String?
  total_round              BigInt   @default(0)
  pref_word_count          String   @default("300-500")
  pref_show_options        Boolean  @default(true)
  pref_custom_instructions String?
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  updated_at               DateTime @default(now()) @db.Timestamptz(6)
  users                    User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bot_users {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String    @unique(map: "bot_users_user_id_uniq")
  tg_username              String?
  tg_first_name            String?
  tg_last_name             String?
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @db.Timestamptz(6)
  bonus_credits            Int       @default(660)
  main_credits             Int?      @default(0)
  total_credits            Int?      @default(dbgenerated("(main_credits + bonus_credits)"))
  first_paid_at            DateTime? @db.Timestamptz(6)
  last_paid_at             DateTime? @db.Timestamptz(6)
  total_paid_amount        Decimal   @default(0) @db.Decimal(12, 2)
  source_id                String?
  total_round              BigInt?   @default(0)
  last_checkin_at          DateTime? @db.Timestamptz(6)
  pref_word_count          String    @default("300-500")
  pref_show_options        Boolean   @default(true)
  pref_custom_instructions String?

  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model botlinks {
  id               BigInt    @id @default(autoincrement())
  bot_link         String?
  source_id        String?   @unique(map: "botlinks_short_code_key")
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  source_name      String?
  start_time       DateTime? @db.Date
  end_time         DateTime? @db.Date
  Purchase_amount  Int?
  Procurement_days Int?

  @@schema("public")
}

model chat_snapshots {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String
  role_id       String?
  snapshot_name String?
  history       Json      @default("[]")
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  round         Int?      @default(0)

  @@index([user_id], map: "idx_chat_snapshots_user_id")
  @@schema("public")
}

model checkin_logs {
  id            BigInt   @id @default(autoincrement())
  user_id       String
  reward        Int
  checked_in_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, checked_in_at(sort: Desc)], map: "idx_checkin_logs_user_time")
  @@schema("public")
}

model miniapp_user_settings {
  user_id                  String   @id @db.Uuid
  tg_username              String?
  tg_first_name            String?
  tg_last_name             String?
  display_name             String?
  avatar_url               String?
  total_round              BigInt   @default(0)
  pref_word_count          String   @default("300-500")
  pref_show_options        Boolean  @default(true)
  pref_custom_instructions String?
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  updated_at               DateTime @default(now()) @db.Timestamptz(6)
  users                    User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("miniapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model payment_orders {
  transaction_id          String   @id
  user_id                 String
  amount                  Decimal  @db.Decimal(10, 2)
  credits_amount          Int      @default(0)
  payment_status          String   @default("pending")
  payment_provider        String
  provider_transaction_id String?
  credits_added           Boolean  @default(false)
  created_at              DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_payment_orders_created")
  @@index([payment_status], map: "idx_payment_orders_status")
  @@index([user_id], map: "idx_payment_orders_user_id")
  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model role_data {
  id                        BigInt    @id(map: "role-data_pkey") @default(autoincrement())
  role_id                   String    @unique(map: "role-data_role_id_key")
  spec                      String?   @default("chara_card_v2")
  spec_version              String?   @default("2.0")
  name                      String?
  description               String?
  personality               String?
  scenario                  String?
  first_mes                 String?
  mes_example               String?
  creator                   String?
  character_version         String?
  creator_notes             String?
  system_prompt             String?
  post_history_instructions String?
  alternate_greetings       Json?     @default("[]")
  character_book            Json?
  tags                      Json?     @default("[]")
  title                     String?
  summary                   String?
  deeplink                  String?
  created_at                DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at                DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  avatar                    String?
  post_link                 String?
  published_at              DateTime? @db.Timestamp(6)

  @@index([role_id])
  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model runtime_config {
  key         String    @id
  value       Json?
  description String?
  version     Int?      @default(1)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  text_value  String?

  @@schema("public")
}

model Character {
  id                        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String
  description               String       @default("")
  avatar_url                String       @default("")
  creator_notes             String       @default("")
  created_at                DateTime     @default(now()) @db.Timestamptz(6)
  updated_at                DateTime     @updatedAt
  alternate_greetings       Json         @default("[]")
  character_book            Json?
  character_version         String       @default("")
  creator                   String       @default("")
  extensions                Json         @default("{}")
  first_mes                 String       @default("")
  mes_example               String       @default("")
  personality               String       @default("")
  post_history_instructions String       @default("")
  scenario                  String       @default("")
  spec                      String       @default("chara_card_v2")
  spec_version              String       @default("2.0")
  system_prompt             String       @default("")
  tags                      Json         @default("[]")
  app_sessions              AppSession[]

  @@map("characters")
  @@schema("miniapp")
}

model AppSession {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String       @db.Uuid
  character_id    String?      @db.Uuid
  last_message_at DateTime     @default(now()) @db.Timestamptz(6)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  custom_name     String?
  is_pinned       Boolean      @default(false)
  is_deleted      Boolean      @default(false)
  app_messages    AppMessage[]
  character       Character?   @relation(fields: [character_id], references: [id])
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, last_message_at(sort: Desc)])
  @@map("app_sessions")
  @@schema("miniapp")
}

model AppMessage {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id String     @db.Uuid
  role       String
  content    String
  is_deleted Boolean    @default(false)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  session    AppSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id, created_at])
  @@map("app_messages")
  @@schema("miniapp")
}

model MiniappRuntimeConfig {
  key         String   @id
  value       Json?
  description String?
  version     Int?     @default(1)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  text_value  String?

  @@map("runtime_config")
  @@schema("miniapp")
}

model traffic_clicks {
  id         BigInt   @id @default(autoincrement())
  stat_date  DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  source_id  String
  clicks     Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([stat_date, source_id], map: "traffic_clicks_uniq")
  @@index([source_id, stat_date], map: "idx_tc_source_date")
  @@schema("public")
}
