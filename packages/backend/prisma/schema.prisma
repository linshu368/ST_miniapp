  wallet_ledger_chat_message_charges_wallet_ledger_idTowallet_ledger wallet_ledger? @relation("chat_message_charges_wallet_ledger_idTowallet_ledger", fields: [wallet_ledger_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, session_id, client_message_id])
  @@index([session_id, created_at(sort: Desc)], map: "idx_miniapp_chat_charges_session")
  @@schema("miniapp")
}

