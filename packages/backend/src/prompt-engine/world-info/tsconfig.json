{
  "extends": "../../../../../tsconfig.base.json",
  "compilerOptions": {
    // 注意：rootDir 不设为 "."，因为 world-info 子树通过
    //   import { ... } from '../macros/runtime/host.js'
    // 把 macros 子树的 .js 拉进 program。设了 rootDir 会触发 TS6059。
    // 让 TS 用默认的「最长公共祖先」即可——本质上就是 ../。
    // 与 instruct/tsconfig.json 同档设计。
    "rootDir": "../",
    "outDir": "../../../dist/prompt-engine/world-info",
    "noEmit": true,
    "types": ["node"],
    // world-info 子树与 macros / instruct 子树同档：
    // 把 .js + JSDoc 当 .ts 严格检查，减少移植时的隐式错误。
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  // 只把 world-info/*.js + world-info/*.ts 算作本 tsconfig 的「源文件」。
  // 被 import 进来的 macros/** 仍会被 TS 纳入 program 类型检查
  // （这是 program 行为，不受 include 控制）。
  "include": ["./**/*.js", "./**/*.ts"],
  "exclude": []
}
