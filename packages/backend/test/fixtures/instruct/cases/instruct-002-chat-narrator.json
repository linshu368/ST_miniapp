{
  "caseId": "instruct-002-chat-narrator",
  "description": "Narrator 消息走 system_sequence/system_suffix（而非 input/output）。验证 isNarrator=true 时 includeNames=false 且 prefix 切到 system 分支。",
  "tags": ["chat", "narrator", "system"],
  "target": "formatInstructChat",
  "input": {
    "instruct": {
      "enabled": true,
      "wrap": true,
      "macro": false,
      "names_behavior": "always",
      "input_sequence": "[INST] ",
      "input_suffix": " [/INST]",
      "output_sequence": "",
      "output_suffix": "</s>",
      "system_sequence": "<<SYS>>\n",
      "system_suffix": "\n<</SYS>>",
      "last_system_sequence": "",
      "first_input_sequence": "",
      "last_input_sequence": "",
      "first_output_sequence": "",
      "last_output_sequence": "",
      "stop_sequence": "</s>",
      "story_string_prefix": "",
      "story_string_suffix": "",
      "user_alignment_message": "",
      "system_same_as_user": false,
      "sequences_as_stop_strings": true,
      "activation_regex": "",
      "bind_to_context": false,
      "skip_examples": false
    },
    "context": {
      "preset": "Llama2",
      "story_string_position": 0,
      "chat_start": "",
      "example_separator": "",
      "use_stop_strings": false
    },
    "sysprompt": { "enabled": false, "content": "" },
    "ctx": {
      "name1": "Bob",
      "name2": "Alice",
      "selectedGroup": null,
      "groups": [],
      "characters": []
    },
    "args": {
      "name": "System",
      "mes": "It is a dark and stormy night.",
      "isUser": false,
      "isNarrator": true,
      "forceAvatar": "",
      "forceOutputSequence": null
    }
  }
}
