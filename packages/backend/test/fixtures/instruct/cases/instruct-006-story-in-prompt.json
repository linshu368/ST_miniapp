{
  "caseId": "instruct-006-story-in-prompt",
  "description": "story_string_position=IN_PROMPT(0)，应套上 story_string_prefix/suffix，prefix 里 {{name}} 被替换成 'System'。",
  "tags": ["story", "in-prompt"],
  "target": "formatInstructStoryString",
  "input": {
    "instruct": {
      "enabled": true,
      "wrap": true,
      "macro": false,
      "names_behavior": "none",
      "input_sequence": "[INST] ",
      "input_suffix": " [/INST]",
      "output_sequence": "",
      "output_suffix": "</s>",
      "system_sequence": "<<SYS>>\n",
      "system_suffix": "\n<</SYS>>",
      "last_system_sequence": "",
      "first_input_sequence": "",
      "last_input_sequence": "",
      "first_output_sequence": "",
      "last_output_sequence": "",
      "stop_sequence": "</s>",
      "story_string_prefix": "<|{{name}}-story-begin|>",
      "story_string_suffix": "<|story-end|>",
      "user_alignment_message": "",
      "system_same_as_user": false,
      "sequences_as_stop_strings": true,
      "activation_regex": "",
      "bind_to_context": false,
      "skip_examples": false
    },
    "context": {
      "preset": "Llama2-with-story",
      "story_string_position": 0,
      "chat_start": "",
      "example_separator": "",
      "use_stop_strings": false
    },
    "sysprompt": { "enabled": false, "content": "" },
    "ctx": {
      "name1": "Bob",
      "name2": "Alice",
      "selectedGroup": null,
      "groups": [],
      "characters": []
    },
    "args": {
      "storyString": "Alice is a curious researcher.\nShe lives in a forest cabin."
    }
  }
}
