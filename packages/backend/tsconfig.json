{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    // The macro engine subtree (src/prompt-engine/macros/**) is hand-ported
    // from SillyTavern as `.js + JSDoc` to keep diffs small. We let TS
    // resolve those imports but skip type-checking them in this main
    // pipeline — the engine has its own stricter tsconfig at
    // src/prompt-engine/macros/tsconfig.json (allowJs + checkJs + strict).
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src"],
  "exclude": ["src/prompt-engine/macros/**/*.js"]
}
