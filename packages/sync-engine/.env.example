# sync-engine 环境变量配置
# 复制为 .env 后填入真实值，切勿提交 .env 到版本控制

# ─── Supabase（service_role，绕过 RLS） ──────────────────────────────────────
# development / test / production
# - test 必须连接 TEST_SUPABASE_PROJECT_REF
# - production 必须连接 PROD_SUPABASE_PROJECT_REF
# - 非 production 默认禁止连接 PROD_SUPABASE_PROJECT_REF
# - 启动时会按 DATABASE_ENV 自动选择 TEST_* 或 PROD_* 变量组
DATABASE_ENV=test

# 测试分支变量组：development / test 环境自动使用。
TEST_SUPABASE_PROJECT_REF=qekxjxpznjvoccvmgozk
TEST_SUPABASE_URL=https://qekxjxpznjvoccvmgozk.supabase.co
TEST_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 生产主库变量组：production 环境自动使用。
PROD_SUPABASE_PROJECT_REF=wbtsfzozlmurljvglhpn
PROD_SUPABASE_URL=https://wbtsfzozlmurljvglhpn.supabase.co
PROD_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 兼容旧部署变量。自动切换会在启动时覆盖这些标准变量。
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 仅紧急人工操作时使用。sync-engine 服务不要配置。
# ALLOW_PROD_DATABASE=true

# ─── ST 文件系统路径 ──────────────────────────────────────────────────────────
# ST 的 data/ 目录绝对路径（每个用户的工作目录在此下：data/<handle>/）
ST_DATA_PATH=/absolute/path/to/SillyTavern/data

# Supabase Storage bucket 名称（角色卡 PNG 存储，默认 character-assets）
# CHARACTER_STORAGE_BUCKET=character-assets

# ─── ST 服务（用于 API 创建用户账号） ─────────────────────────────────────────
ST_BASE_URL=http://localhost:8000
# ST 管理员账号密码（用于 POST /api/users/create）
ST_ADMIN_USERNAME=admin
ST_ADMIN_PASSWORD=your-admin-password

# 用户密码派生密钥（HMAC-SHA256(secret, handle) → 每个 ST 用户的登录密码）
# Bridge 登录 ST 时使用相同公式派生密码，保证两端一致
ST_USER_PASSWORD_SECRET=change-me-to-a-random-secret-string

# ST 的 LLM endpoint 指向平台代理网关的可达地址（provision 写入 settings.json 的
# oai_settings.custom_url / reverse_proxy）。本地默认 backend dev 地址；
# prod/staging 必须覆盖为 ST 进程可达的 backend 网关 URL（如 https://<backend-domain>/api/platform/llm-proxy/v1）。
LLM_PROXY_URL=http://localhost:3001/api/platform/llm-proxy/v1

# ─── 健康监控 ─────────────────────────────────────────────────────────────────
# 健康检查 HTTP 端口（绑定 127.0.0.1，仅本机访问）
# 0 = 禁用 health server；默认 9090
HEALTH_PORT=9090

# ─── Provision API（供 backend 调用 provision） ────────────────────────────────
# 内网 HTTP 端口，绑定 127.0.0.1，仅同机 backend 调用
# 与 backend 的 ST_PROVISION_URL=http://127.0.0.1:9091 对应
# 0 = 禁用；默认 9091
PROVISION_API_PORT=9091

# Bind host for provision API HTTP server.
# - Local dev: keep default 127.0.0.1 (loopback only, safest).
# - Container / Railway: set to 0.0.0.0 so backend service can reach
#   provision-api via internal DNS (http://<st-bundle>.railway.internal:9091).
PROVISION_API_BIND_HOST=127.0.0.1

# ─── 日志 ────────────────────────────────────────────────────────────────────
# 日志级别：trace / debug / info / warn / error / fatal / silent
# 默认 info；NODE_ENV=test 时自动 silent
LOG_LEVEL=info
